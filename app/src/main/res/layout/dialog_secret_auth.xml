<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="@dimen/vs_720"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_dialog_bg_main"
        android:orientation="vertical"
        android:padding="@dimen/vs_25">

        <!-- Title Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="🔒 私密频道安全鉴权"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_24"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_5"
            android:gravity="center"
            android:text="遥控器输入密码 或 手机扫码一键解锁"
            android:textColor="@color/color_FFFFFF_70"
            android:textSize="@dimen/ts_14" />

        <!-- Two Columns Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_20"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Left: Remote PIN Input -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/vs_10">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="遥控器输入密码"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_18" />

                <EditText
                    android:id="@+id/etSecretPin"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/vs_50"
                    android:layout_marginTop="@dimen/vs_15"
                    android:background="@drawable/input_dialog_api_input"
                    android:gravity="center"
                    android:hint="输入管理密码"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:padding="@dimen/vs_10"
                    android:textColor="@color/color_000000_80"
                    android:textColorHint="@color/color_3D3D3D_45"
                    android:textSize="@dimen/ts_20" />

                <TextView
                    android:id="@+id/btnVerifyPin"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/vs_50"
                    android:layout_marginTop="@dimen/vs_15"
                    android:background="@drawable/button_dialog_main"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="验证并解锁"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_18" />

                <TextView
                    android:id="@+id/tvPinStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_10"
                    android:gravity="center"
                    android:text=""
                    android:textColor="#FF5555"
                    android:textSize="@dimen/ts_14" />
            </LinearLayout>

            <!-- Middle Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/vs_10"
                android:layout_marginRight="@dimen/vs_10"
                android:background="#33FFFFFF" />

            <!-- Right: QR Code Mobile Unlock -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/vs_10">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="手机扫码免输密码"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_18" />

                <ImageView
                    android:id="@+id/ivSecretQr"
                    android:layout_width="@dimen/vs_150"
                    android:layout_height="@dimen/vs_150"
                    android:layout_marginTop="@dimen/vs_10"
                    android:background="@color/color_FFFFFF"
                    android:contentDescription="QR Code"
                    android:focusable="false"
                    android:padding="@dimen/vs_5" />

                <TextView
                    android:id="@+id/tvQrStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_10"
                    android:gravity="center"
                    android:text="微信或浏览器扫码一键解锁"
                    android:textColor="@color/color_FFFFFF_70"
                    android:textSize="@dimen/ts_14" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_15"
            android:gravity="center"
            android:text="注：安全保护模式生效中，退出应用将自动重新上锁"
            android:textColor="@color/color_FFFFFF_50"
            android:textSize="@dimen/ts_12" />
    </LinearLayout>
</FrameLayout>
